# Local configuration (do not commit this file)
# Enable DeepSeek OCR (optional)
OCR_PROVIDER=deepseek

# Set your DeepSeek API key (rotate/revoke any key you have shared publicly)
DEEPSEEK_API_KEY=sk-488c5c2e0e97448ea288d543f6f0732b

# DeepSeek OCR2 endpoint URL (required for deepseek OCR provider)
DEEPSEEK_OCR2_URL=https://api.deepseek.com/chat/completions

LIGHTON_LOCAL_ENABLED=true
LIGHTON_LOCAL_MODEL_NAME=LightOnOCR-2-1B (Best OCR)

# If you want to disable OCR entirely
# BANKPDF_OCR=0
VLLM_ENDPOINT_OCR=http://127.0.0.1:8001/v1
VLLM_ENDPOINT_BBOX=http://127.0.0.1:8002/v1